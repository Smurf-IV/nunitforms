<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
	<PropertyGroup>
		<TargetFrameworks>net462;net48;net6.0-windows;net8.0-windows;net10.0-windows</TargetFrameworks>
		<AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
		<IsTestProject>false</IsTestProject>
		<IsTestExecutionHost>false</IsTestExecutionHost>
		<!-- Set the CheckEolTargetFramework property as false to fix the warning -->
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
		<UseWindowsForms>true</UseWindowsForms>
		<OutputType>Library</OutputType>
		<DocumentationFile>NUnitForms.Recorder.XML</DocumentationFile>

		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<WarningLevel>9999</WarningLevel>
		<NeutralLanguage>en</NeutralLanguage>
		<LangVersion>preview</LangVersion>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>

		<!-- Force consistent architecture for multi-targeting -->
		<PlatformTarget>AnyCPU</PlatformTarget>
		<Prefer32Bit>false</Prefer32Bit>

		<!-- .NET 8+ Performance Optimizations -->
		<TieredCompilation>true</TieredCompilation>
		<TieredCompilationQuickJit>true</TieredCompilationQuickJit>
		<TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
		<TieredPGO>true</TieredPGO>
		<!-- NEW in .NET 9: Dynamic PGO gets better -->
		<TieredCompilationDynamicPgo>true</TieredCompilationDynamicPgo>
	</PropertyGroup>

	<PropertyGroup>
		<Title>NUnitForms.Recorder</Title>
		<PackageId>NUnitForms.Recorder</PackageId>
		<RepositoryType>git</RepositoryType>
		<Copyright>NUnitForms.Recorder Copyright ©  2003-2007, Luke T. Maxon : Then 2026-2026 © Smurf-IV</Copyright>
	</PropertyGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\NUnitForms\NUnitForms.csproj" />
	</ItemGroup>

</Project>