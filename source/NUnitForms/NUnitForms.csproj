<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
	<PropertyGroup>
		<TargetFrameworks>net462;net48;net6.0-windows;net8.0-windows;net10.0-windows</TargetFrameworks>
		<AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
		<IsTestProject>false</IsTestProject>
		<IsTestExecutionHost>false</IsTestExecutionHost>
		<!-- Set the CheckEolTargetFramework property as false to fix the warning -->
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
		<UseWindowsForms>true</UseWindowsForms>
		<IsPublishable>True</IsPublishable>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<RootNamespace>NUnit.Extensions.Forms</RootNamespace>

		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<WarningLevel>9999</WarningLevel>
		<NeutralLanguage>en</NeutralLanguage>
		<LangVersion>preview</LangVersion>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>

		<!-- Force consistent architecture for multi-targeting -->
		<PlatformTarget>AnyCPU</PlatformTarget>
		<Prefer32Bit>false</Prefer32Bit>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- .NET 8+ Performance Optimizations -->
		<TieredCompilation>true</TieredCompilation>
		<TieredCompilationQuickJit>true</TieredCompilationQuickJit>
		<TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
		<TieredPGO>true</TieredPGO>
		<!-- NEW in .NET 9: Dynamic PGO gets better -->
		<TieredCompilationDynamicPgo>true</TieredCompilationDynamicPgo>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Condition="'$(TargetFramework)' == 'net462'" Include="Microsoft.SourceLink.GitHub" Version="1.1.1" PrivateAssets="all" />
		<PackageReference Condition="'$(TargetFramework)' == 'net48'" Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="all" />
		<PackageReference Condition="'$(TargetFramework)' == 'net6.0-windows'" Include="Microsoft.SourceLink.GitHub" Version="1.1.1" PrivateAssets="all" />
		<PackageReference Condition="'$(TargetFramework)' == 'net8.0-windows'" Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="all" />
		<PackageReference Condition="'$(TargetFramework)' == 'net10.0-windows'" Include="Microsoft.SourceLink.GitHub" Version="11.0.100-preview.7.26381.103">
			<!-- Used for source code linking in NuGet packages.
				Microsoft.SourceLink.GitHub/11.0.100-preview.2.26159.112
				  ├── System.IO.Hashing/11.0.0-preview.2.26159.112  ← Pulled in here
				  ├── Microsoft.Build.Tasks.Git/11.0.100-preview.2.26159.112
				  │   └── System.IO.Hashing/11.0.0-preview.2.26159.112
				  └── Microsoft.SourceLink.Common/11.0.100-preview.2.26159.112
				  -->
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<PropertyGroup>
		<Title>NUnitForms</Title>
		<PackageId>NUnitForms</PackageId>
		<RepositoryType>git</RepositoryType>
		<Copyright>NUnitForms Copyright ©  2003-2007, Luke T. Maxon : Then 2026-2026 © Smurf-IV</Copyright>
		<PackageProjectUrl>https://github.com/Smurf-IV/Excel_PRIME</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Smurf-IV/Excel_PRIME</RepositoryUrl>
		<PackageTags>csharp;xml;zip;excel;netcore;reader</PackageTags>
		<PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
		<Authors>Luke T. Maxon; Smurf-IV</Authors>
		<Deterministic>False</Deterministic>
		<VersionPrefix>3.$([System.DateTime]::UtcNow.ToString(yyMM)).$([System.DateTime]::UtcNow.ToString(dd))</VersionPrefix>
		<!--<VersionSuffix>beta ... Do this is the yml file</VersionSuffix>-->
		<PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/../../Release_Notes.md"))</PackageReleaseNotes>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageReadmeFile>Package_ReadMe.md</PackageReadmeFile>
	</PropertyGroup>
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Package_ReadMe.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<Target Name="PrepareReleaseNotes" BeforeTargets="GenerateNuspec">
		<PropertyGroup>
			<PackageDescription>$([System.IO.File]::ReadAllText("../../Release_Notes.md"))</PackageDescription>
		</PropertyGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="NUnit" Version="4.6.1" />
	</ItemGroup>
</Project>