<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net462</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>NUnit.Extensions.Forms.TestApplications</RootNamespace>
		<LangVersion>latest</LangVersion>
		<IsWebBootstrapper>false</IsWebBootstrapper>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<NoWarn>NU1605</NoWarn>
		<PublishUrl>publish\</PublishUrl>
		<Install>true</Install>
		<InstallFrom>Disk</InstallFrom>
		<UpdateEnabled>false</UpdateEnabled>
		<UpdateMode>Foreground</UpdateMode>
		<UpdateInterval>7</UpdateInterval>
		<UpdateIntervalUnits>Days</UpdateIntervalUnits>
		<UpdatePeriodically>false</UpdatePeriodically>
		<UpdateRequired>false</UpdateRequired>
		<MapFileExtensions>true</MapFileExtensions>
		<ApplicationRevision>0</ApplicationRevision>
		<ApplicationVersion>1.0.0.%2a</ApplicationVersion>
		<UseApplicationTrust>false</UseApplicationTrust>
		<BootstrapperEnabled>true</BootstrapperEnabled>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<UseWindowsForms>true</UseWindowsForms>
		<ImortWindowsDesktopTargets>true</ImortWindowsDesktopTargets>
		<DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="NMock2, Version=1.0.2313.18049, Culture=neutral, processorArchitecture=MSIL">
			<SpecificVersion>False</SpecificVersion>
			<HintPath>..\..\lib\NMock\NMock2.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<Compile Update="TestForms\ButtonControl.cs">
			<SubType>UserControl</SubType>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NUnitForms.Recorder\NUnitForms.Recorder.csproj" />
		<ProjectReference Include="..\NUnitForms\NUnitForms.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NUnit.Runners" Version="2.6.4" />
		<PackageReference Include="System.Resources.Extensions" Version="6.0.0" />
	</ItemGroup>

	<ItemGroup Label="Compile items now included by globbing that were not in the original project file">
		<Compile Remove="TestForms\ToolStripTestForm.cs" />
		<Compile Remove="ModalFormsTestOld.cs" />
	</ItemGroup>
</Project>